              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"tick\",\n  \"data\": {\n    \"key\": \"value\"\n  }\n}"
            },
            "url": "{{baseUrl}}/webgame/update"
          }
        }
      ]
    }
  ]
}