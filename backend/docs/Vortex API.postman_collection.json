      "name": "Auth",
      "item": [
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"token\", jsonData.data.token); pm.environment.set(\"TOKEN\", jsonData.data.token);",
                  "    console.log(\"TOKEN salvo no ambiente:\", jsonData.data.token);",
                  "} else {",
                  "    console.warn(\"Token não encontrado na resposta.\");",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
